# ── Server ────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# Public base URL of this API (used for locally stored uploads)
PUBLIC_API_URL=http://localhost:4000

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexlm?schema=public

# ── Auth & crypto ─────────────────────────────────────
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
# 32 bytes as hex (64 chars). Encrypts custodial Stellar secret keys at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Stellar ───────────────────────────────────────────
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
# Platform master key — co-signer on every escrow account. KEEP THIS SECRET.
PLATFORM_SECRET_KEY=

# ── Trading rules ─────────────────────────────────────
TRADE_PAYMENT_WINDOW_MINUTES=15
ORDER_TTL_MINUTES=30
MIN_TRADE_XLM=10
MAX_TRADE_XLM=100000
REQUIRE_KYC=true

# ── Email (optional — logs to console when unset) ─────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nexlm <no-reply@nexlm.app>"

# ── Uploads (optional — stores to ./uploads when unset) ─
CLOUDINARY_URL=

# ── KYC: Smile Identity (optional — manual review when unset) ─
SMILE_PARTNER_ID=
SMILE_API_KEY=
SMILE_ENV=sandbox
